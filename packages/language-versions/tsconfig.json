{
  "compilerOptions": {
    "lib": ["es2022"],
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // Compiling is `tsconfig.build.json`'s job. A bare tsc here would write .js
    // beside every .ts, and jest then resolves those instead of the sources.
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "exclude": ["node_modules", "dist", "jest.config.cjs"]
}
