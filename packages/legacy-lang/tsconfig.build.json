// The compiled artifact: the api's build emits this package into its OWN output
// tree (`build/node_modules/legacy-lang`, the alias its importers spell), the
// same arrangement as the other source packages, so a compiled `node build/...`
// boot resolves it. The build copies the frozen parser artifact beside its loader.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist", "jest.config.ts", "**/__test__/**", "__conformance__", "conformance", "parity"]
}
