// The compiled artifact, the arrangement engine-contracts uses: a SOURCE
// package (`main`/`types`/`exports` name `index.ts`), and the application
// build emits it into its own output tree, never beside the sources.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist"]
}
