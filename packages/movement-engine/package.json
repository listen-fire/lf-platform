{
  "name": "@listen-fire/engine",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.3",
  "description": "The movement engine and its host contract, moved out of apps/api so every shell (the hosted product, the `lf` command line) runs the same engine: the TypeScript engine, the Rust engine's shim, the EngineHost families, and the adapter and model types they reach. Paths mirror apps/api/src so the move stayed mechanical. Its own tests borrow apps/api's jest runner (jest.config.borrowed.cjs); engine tests that need the platform still live in apps/api. Embedders reach it only through public/* (the exports map); the internals resolve only under the `movement-engine-internals` condition, which only test runners set",
  "engines": {
    "node": "22.20.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./public/*": "./public/*.ts",
    "./services/translation_graph/adapters/remote": {
      "movement-engine-internals": "./services/translation_graph/adapters/remote/index.ts"
    },
    "./*": {
      "movement-engine-internals": "./*.ts"
    }
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "node ../../apps/api/node_modules/jest/bin/jest.js --config jest.config.borrowed.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/engine-contracts": "workspace:^",
    "@listen-fire/module-runtime": "workspace:^",
    "@listen-fire/movement-lang": "workspace:^",
    "@listen-fire/shared": "workspace:^",
    "safe-stable-stringify": "2.5.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "#shared": "workspace:@listen-fire/shared@*",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "module-kit": "workspace:@listen-fire/module-kit@*",
    "module-runtime": "workspace:@listen-fire/module-runtime@*",
    "movement-lang": "workspace:@listen-fire/movement-lang@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/movement-engine"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      "./public/*": {
        "types": "./dist/public/*.d.ts",
        "default": "./dist/public/*.js"
      }
    },
    "typesVersions": {
      "*": {
        "public/*": [
          "dist/public/*"
        ]
      }
    },
    "tag": "next"
  }
}
