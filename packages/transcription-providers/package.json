{
  "name": "@listen-fire/transcription-providers",
  "license": "Apache-2.0",
  "version": "0.12.6",
  "description": "Audio transcription behind the model map (OpenAI, Gemini). The vendor SDKs are optional peers loaded on first use; the environment and the host answers (usage recording, token counting) are passed in as @listen-fire/model-providers' ModelHost.",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "jest --config jest.config.cjs"
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/engine": "catalog:",
    "zod": "4.1.12",
    "@listen-fire/model-providers": "0.12.6"
  },
  "peerDependencies": {
    "@google/genai": "^2.24.0",
    "openai": "5.22.0"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/genai": "^2.24.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "movement-engine": "catalog:",
    "openai": "5.22.0",
    "typescript": "5.5.4",
    "model-providers": "npm:@listen-fire/model-providers@0.12.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/transcription-providers"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    },
    "tag": "next"
  }
}
