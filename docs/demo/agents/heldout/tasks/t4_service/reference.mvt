# The grader's own proof: a hand-written program for T4, never shown to a model.
facilities = connect `@lf/airtable` using team_airtable { base: "Facilities" }

function `Plan Services`(t: <cron-[:Tick]->>) {
  horizon = Date.addDays(Date.from(t.`Fired at`), 7)
  open = facilities-[j:`Service Jobs` WHERE j.Status != "Done"]-> { return j.Equipment }
  facilities-[q:Equipment WHERE q.Status != "Retired"]-> {
    if (q.`Next Service` <= horizon && !List.includes(open, q.Name)) {
      write facilities-[:`Service Jobs`]-> {
        Equipment: q.Name,
        Due: q.`Next Service`,
        Status: "To do"
      }
    }
  }
}

listen to cron-[t:Ticks WHERE t.Schedule == "0 7 * * *" AND t.Zone == "UTC"]-> fire `Plan Services`
