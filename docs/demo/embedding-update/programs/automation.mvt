app  = connect #crm using workspace
team = connect `@lf/slack` using slack_workspace

function kick_off(change: <app-[:Change]->>) {
  company = only(change-[:Company]->)
  if (company == null) { fail("the company is gone") }
  write company { Onboarding: "Kickoff booked" }
  deals = only(team-[ch:Channels WHERE ch.Name == "deals"]->)
  if (deals == null) { fail("there is no #deals channel") }
  write deals-[:Messages]-> { Message: "Deal won: ${company.Name} (owner: ${company.Owner})" }
}

listen to app-[c:Changes WHERE c.Current.Stage == "Won" AND c.Previous.Stage != "Won"]-> fire kick_off
