[
  {
    "id": "good-signature",
    "door": "slack_events",
    "note": "A signed event_callback is written as a slack_event row keyed on its event_id, then acked {ok:true}.",
    "request": {
      "method": "POST",
      "path": "/api/public/slack/events",
      "headers": {
        "content-type": "application/json",
        "x-slack-request-timestamp": "1792238400",
        "x-slack-signature": "v0=47d76a5dc1a485b01674d7be659964e42bbb44f9e77ab74790241346a3596c3d"
      },
      "body": "{\"type\":\"event_callback\",\"event_id\":\"Ev9\",\"team_id\":\"T9\",\"event\":{\"type\":\"message\",\"channel\":\"C9\",\"user\":\"U9\",\"ts\":\"1760702400.000900\",\"text\":\"hi\"}}"
    },
    "response": {
      "status": 200,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "11"
      },
      "body": "{\"ok\":true}"
    },
    "effects": [
      {
        "kind": "enqueue_work",
        "row": {
          "kind": "slack_event",
          "key": "slack_event:Ev9",
          "payload": {
            "envelope": {
              "type": "event_callback",
              "event_id": "Ev9",
              "team_id": "T9",
              "event": {
                "type": "message",
                "channel": "C9",
                "user": "U9",
                "ts": "1760702400.000900",
                "text": "hi"
              }
            }
          }
        }
      },
      {
        "kind": "notify_work"
      }
    ]
  },
