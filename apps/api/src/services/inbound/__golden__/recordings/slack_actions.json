[
  {
    "id": "button-tap-fires-callback",
    "door": "slack_actions",
    "note": "A signed block action carrying a callback id fires it and queues the reply that replaces the original message (a slack_response row keyed on trigger_id).",
    "request": {
      "method": "POST",
      "path": "/api/public/slack-actions",
      "headers": {
        "content-type": "application/x-www-form-urlencoded",
        "x-slack-request-timestamp": "1760702400",
        "x-slack-signature": "v0=9551bbba50adb9c489ed489820cacc39991439348b99632d02ab1d657bd6cead"
      },
      "body": "payload=%7B%22type%22%3A%22block_actions%22%2C%22response_url%22%3A%22https%3A%2F%2Fhooks.slack.test%2Factions%2FT9%2F1%2Fabc%22%2C%22trigger_id%22%3A%221760702400.golden%22%2C%22actions%22%3A%5B%7B%22action_id%22%3A%22btn%22%2C%22value%22%3A%22cb_golden0001%22%7D%5D%7D"
    },
    "response": {
      "status": 200,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "11"
      },
      "body": "{\"ok\":true}"
    },
    "effects": [
      {
        "kind": "fire_callback",
        "id": "cb_golden0001",
        "values": {}
      },
      {
        "kind": "enqueue_work",
        "row": {
          "kind": "slack_response",
          "key": "slack_response:1760702400.golden",
          "payload": {
            "responseUrl": "https://hooks.slack.test/actions/T9/1/abc",
            "body": {
              "replace_original": true,
              "text": "Thanks — that has been recorded.",
              "blocks": [
                {
                  "type": "section",
                  "text": {
                    "type": "mrkdwn",
                    "text": ":white_check_mark: Thanks — that has been recorded."
                  }
                }
              ]
            }
          }
        }
      },
      {
        "kind": "notify_work"
      }
    ]
  },
