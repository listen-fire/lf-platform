  {
    "id": "message-good-signature",
    "door": "whatsapp",
    "note": "A signed text message is written as a whatsapp_message row keyed on its wamid, then acked EVENT_RECEIVED; the ops notice and the dispatch run when the row drains.",
    "request": {
      "method": "POST",
      "path": "/api/public/whatsapp/webhook",
      "headers": {
        "content-type": "application/json",
        "x-hub-signature-256": "sha256=11b6287da66af5fca53fe77462353b0810364a9bb71f4918330a22cf8e29c91f"
      },
      "body": "{\"object\":\"whatsapp_business_account\",\"entry\":[{\"id\":\"waba-1\",\"changes\":[{\"field\":\"messages\",\"value\":{\"metadata\":{\"display_phone_number\":\"15550001111\",\"phone_number_id\":\"pn-1\"},\"contacts\":[{\"wa_id\":\"15550002222\",\"profile\":{\"name\":\"Ada\"}}],\"messages\":[{\"from\":\"15550002222\",\"id\":\"wamid.10\",\"timestamp\":\"1760702400\",\"type\":\"text\",\"text\":{\"body\":\"see https://example.com/a/b\"}}]}}]}]}"
    },
    "response": {
      "status": 200,
      "headers": {
        "content-type": "text/html; charset=utf-8",
        "content-length": "14"
      },
      "body": "EVENT_RECEIVED"
    },
    "effects": [
      {
        "kind": "enqueue_work",
        "row": {
          "kind": "whatsapp_message",
          "key": "whatsapp_message:wamid.10",
          "payload": {
            "message": {
              "from": "15550002222",
              "id": "wamid.10",
              "timestamp": "1760702400",
              "type": "text",
              "text": {
                "body": "see https://example.com/a/b"
              }
            },
            "profileName": "Ada",
            "businessNumber": "15550001111",
            "businessPhoneNumberId": "pn-1",
            "announce": true
          }
        }
      },
      {
        "kind": "notify_work"
      }
    ]
  },
