[
  {
    "id": "emit-good-credential",
    "door": "adapter_doors",
    "note": "An authenticated emit is refused by name, 410: listen-fire 0.13 retired it for arrivals.",
    "request": {
      "method": "POST",
      "path": "/api/public/adapter/acme-crm/emit",
      "headers": {
        "content-type": "application/json",
        "x-listen-fire-adapter-secret": "golden-adapter-door-secret-0001"
      },
      "body": "{\"events\":[{\"eventType\":\"record.created\",\"externalId\":\"r-1\",\"payload\":{\"id\":\"r-1\"}}]}"
    },
    "response": {
      "status": 410,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "264"
      },
      "body": "{\"error\":\"emit_retired\",\"message\":\"`emit` is retired in listen-fire 0.13: a listen is a traversal, fired by the arrivals on its edge, so an event fires no listen; send what happened to `wake` as `arrivals` (docs/contracts/adapter-protocol.md, Reporting arrivals)\"}"
    },
    "effects": []
  },
