  {
    "id": "wake-good-credential",
    "door": "adapter_doors",
    "note": "A wake naming keys is refused 400: since adapter protocol 2.5 a wake names what arrived.",
    "request": {
      "method": "POST",
      "path": "/api/public/adapter/acme-crm/wake",
      "headers": {
        "content-type": "application/json",
        "x-listen-fire-adapter-secret": "golden-adapter-door-secret-0001"
      },
      "body": "{\"keys\":[\"thread:abc\",\"thread:def\"]}"
    },
    "response": {
      "status": 400,
      "headers": {
        "content-type": "application/json; charset=utf-8",
        "content-length": "282"
      },
      "body": "{\"error\":\"bad_request\",\"issues\":[{\"path\":\"keys\",\"message\":\"a wake names what arrived from adapter protocol 2.5: send `arrivals`, not `keys` (docs/contracts/adapter-protocol.md, Reporting arrivals)\"},{\"path\":\"arrivals\",\"message\":\"Invalid input: expected array, received undefined\"}]}"
    },
    "effects": []
  },
