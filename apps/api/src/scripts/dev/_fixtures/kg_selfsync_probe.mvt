graph = connect #kg using `Dev Loop Knowledge`

function kg_selfsync_probe(change: <graph-[:`Organisation Change`]->>) {
  change-[org:Record]-> {
    write graph-[:Organisation]-> {
      Name: org.Name
      Sector: "Synced"
    }
  }
}

listen to graph-[:Organisation]->-[c:Changes WHERE c.Kind == "created"]-> fire kg_selfsync_probe
